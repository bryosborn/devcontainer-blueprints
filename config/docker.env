REGISTRY=devcontainers
# Canonical container/artifact target. The shared environment loader derives
# the VS Code, toolchain, and Rust architecture selectors from this value.
DOCKER_PLATFORM=linux/amd64
BASE_IMAGE_NAME=base-dod
BASE_IMAGE_VERSION=0.2.0
BASE_IMAGE=${REGISTRY}/${BASE_IMAGE_NAME}:${BASE_IMAGE_VERSION}

# Rolling tag that follows the newest 3.0.x Ubuntu 22.04 base image.
# Pin an exact patch tag in a private DOCKER_ENV_FILE when reproducibility is
# more important than automatically receiving upstream image updates.
UPSTREAM_BASE_IMAGE=mcr.microsoft.com/devcontainers/base:3.0-ubuntu22.04

DOD_FEATURE_REF=ghcr.io/devcontainers/features/docker-outside-of-docker
DOD_FEATURE_VERSION=1.10.0
DOD_DOCKER_CE_CLI_VERSION=29.8.0-1
DOD_DOCKER_COMPOSE_VERSION=5.5.1
DOD_DOCKER_BUILDX_VERSION=0.37.0-1
DOD_FEATURE_MOBY=false
DOD_FEATURE_DOCKER_DASH_COMPOSE_VERSION=latest
DOD_FEATURE_INSTALL_DOCKER_BUILDX=true
DOD_FEATURE_INSTALL_DOCKER_COMPOSE_SWITCH=false
DOD_FEATURE_ENABLE_NONROOT_DOCKER=true

BASE_VSCODE_TEMPLATE_ID=base-vscode
BASE_VSCODE_IMAGE_NAME=base-vscode
BASE_VSCODE_IMAGE_VERSION=0.2.0
BASE_VSCODE_IMAGE=${REGISTRY}/${BASE_VSCODE_IMAGE_NAME}:${BASE_VSCODE_IMAGE_VERSION}
BASE_VSCODE_VERSION=1.136.1
# Optional exact override. Leave empty to use BASE_VSCODE_VERSION.
BASE_VSCODE_COMMIT=
BASE_VSCODE_QUALITY=stable
BASE_VSCODE_REMOTE_USER=vscode
BASE_VSCODE_ARTIFACT_ROOT=artifacts/vscode-server

BASE_TOOLCHAIN_IMAGE_NAME=base-toolchain
BASE_TOOLCHAIN_IMAGE_VERSION=0.2.0
BASE_TOOLCHAIN_IMAGE=${REGISTRY}/${BASE_TOOLCHAIN_IMAGE_NAME}:${BASE_TOOLCHAIN_IMAGE_VERSION}
BASE_TOOLCHAIN_TEMPLATE_ID=base-toolchain
BASE_TOOLCHAIN_INSTALL_APT=${BASE_TOOLCHAIN_INSTALL_APT:-true}
BASE_TOOLCHAIN_INSTALL_PYTHON_PIP=${BASE_TOOLCHAIN_INSTALL_PYTHON_PIP:-true}
BASE_TOOLCHAIN_INSTALL_JAVA_MAVEN=${BASE_TOOLCHAIN_INSTALL_JAVA_MAVEN:-true}
BASE_TOOLCHAIN_INSTALL_NODE=${BASE_TOOLCHAIN_INSTALL_NODE:-true}
BASE_TOOLCHAIN_INSTALL_CLI_TOOLS=${BASE_TOOLCHAIN_INSTALL_CLI_TOOLS:-true}
BASE_TOOLCHAIN_INSTALL_MONGODB_TOOLS=${BASE_TOOLCHAIN_INSTALL_MONGODB_TOOLS:-true}
BASE_TOOLCHAIN_INSTALL_RUST=${BASE_TOOLCHAIN_INSTALL_RUST:-true}
BASE_TOOLCHAIN_INSTALL_VSCODE_EXTENSIONS=${BASE_TOOLCHAIN_INSTALL_VSCODE_EXTENSIONS:-true}

# Docker images saved into artifacts/docker-images/ for disconnected restores.
# BASE_VSCODE_IMAGE is the direct parent for BASE_TOOLCHAIN_IMAGE builds.
# BASE_IMAGE is included so the VS Code layer can also be rebuilt locally.
ARTIFACT_IMAGE_REFS="${BASE_IMAGE} ${BASE_VSCODE_IMAGE} ${BASE_TOOLCHAIN_IMAGE}"

APT_ARTIFACT_ROOT=artifacts/apt
APT_PACKAGE_LIST=src/apt-artifacts/apt-packages.txt
APT_PREFETCH_IMAGE=${UPSTREAM_BASE_IMAGE}
APT_INCLUDE_DEADSNAKES=true
