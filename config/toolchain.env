# Toolchain artifact defaults.
# Versions below are concrete snapshots resolved on 2026-09-04. Node and Helm
# intentionally follow the latest 24.x and 3.x releases; Rust follows that
# day's nightly.
# Empty hashes skip the optional configured-pin check during prefetch. Each
# prefetch still calculates and records the downloaded artifact's actual hash.

# Platform selectors are derived from DOCKER_PLATFORM by scripts/env.sh.
TOOLCHAIN_ARTIFACT_ROOT=artifacts/toolchain
TOOLCHAIN_TEST_BASE_IMAGE=${UPSTREAM_BASE_IMAGE:-mcr.microsoft.com/devcontainers/base:3.0-ubuntu22.04}

JAVA_VERSION=26.0.2.1+1
JAVA_SHA256=

MAVEN_VERSION=3.9.16
MAVEN_SHA512=

NODE_VERSION=24.20.0
NODE_SHA256=

HELM_VERSION=3.21.4
HELM_SHA256=

KUBECTL_VERSION=1.37.0
# Kubernetes publishes this checksum as SHA512 for kubernetes-client-linux-amd64.tar.gz.
KUBECTL_SHA512=

ORAS_VERSION=1.3.4
ORAS_SHA256=

YQ_VERSION=4.53.6
YQ_SHA256=

MONGOSH_VERSION=2.10.0
MONGOSH_SHA256=

MONGODB_DATABASE_TOOLS_VERSION=100.18.0
MONGODB_DATABASE_TOOLS_SHA256=

RUST_TOOLCHAIN=nightly-2026-09-04
RUST_COMPONENTS="rust-src rustfmt clippy"
RUSTUP_HOME=/usr/local/rustup
CARGO_HOME=/usr/local/cargo
RUSTUP_INIT_VERSION=1.29.1
RUSTUP_INIT_SHA256=
