{
  "name": "Wolfi Base VS Code Server",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "BASE_IMAGE": "devcontainers/wolfi-base-dod:0.1.0",
      "REMOTE_USER": "vscode",
      "VSCODE_COMMIT": "0000000000000000000000000000000000000000",
      "VSCODE_QUALITY": "stable",
      "VSCODE_SERVER_PLATFORM": "server-linux-x64",
      "VSCODE_SERVER_ARCHIVE_RELATIVE": "stable/0000000000000000000000000000000000000000/server-linux-x64/vscode-server-linux-x64.tar.gz",
      "VSCODE_EXTENSIONS_ARCHIVE_NAME": "vscode-extensions.tar.gz",
      "WOLFI_APK_ARCHITECTURE": "x86_64",
      "WOLFI_APK_REPOSITORY_SUBDIRS": "repositories/main repositories/extra",
      "WOLFI_VSCODE_APK_PACKAGES": ""
    },
    "options": [
      "--network=none",
      "--build-context",
      "wolfi_apks=${localWorkspaceFolder}/../../../artifacts/wolfi/linux-amd64/apk",
      "--build-context",
      "vscode_server=${localWorkspaceFolder}/../../../artifacts/wolfi/linux-amd64/vscode-server",
      "--build-context",
      "vscode_extensions=${localWorkspaceFolder}/../../../artifacts/wolfi/linux-amd64/vscode-extensions",
      "--build-context",
      "vscode_helpers=${localWorkspaceFolder}/../../base-vscode/scripts"
    ]
  },
  "containerUser": "root",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": false
      }
    }
  }
}
